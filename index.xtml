<!DOCTYPE html>
<html lang="hi" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FIT IN 7 - Luxury Personal Coaching & Fitness Transformation</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        gold: '#D4AF37',
                        goldHover: '#B59223',
                        goldLight: '#F3E5AB',
                        obsidian: '#0F0F0F',
                        surface: '#18181B',
                        cardBg: '#27272A',
                    },
                    fontFamily: {
                        display: ['Cinzel', 'serif'],
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #0F0F0F;
            color: #F4F4F5;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        .gold-gradient-text {
            background: linear-gradient(135deg, #FFF 0%, #D4AF37 50%, #AA7C11 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .gold-border-glow {
            box-shadow: 0 0 25px rgba(212, 175, 55, 0.15);
        }
        .gold-btn {
            background: linear-gradient(135deg, #D4AF37 0%, #AA7C11 100%);
            color: #000;
            transition: all 0.3s ease;
        }
        .gold-btn:hover {
            background: linear-gradient(135deg, #F3E5AB 0%, #D4AF37 100%);
            box-shadow: 0 0 20px rgba(212, 175, 55, 0.4);
            transform: translateY(-2px);
        }
        .bicep-badge {
            background: linear-gradient(135deg, #D4AF37 0%, #AA7C11 100%);
            box-shadow: 0 0 15px rgba(212, 175, 55, 0.5);
        }
    </style>
</head>
<body class="antialiased text-gray-200">

    <!-- HEADER / NAVIGATION -->
    <header class="fixed top-0 left-0 right-0 z-40 bg-obsidian/90 backdrop-blur-md border-b border-white/10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-xl bg-gold/20 border border-gold flex items-center justify-center font-display font-black text-gold text-xl relative overflow-hidden group">
                    <span class="z-10">7</span>
                    <i class="fa-solid fa-dumbbell text-[10px] absolute -bottom-1 -right-1 text-gold/40"></i>
                </div>
                <div>
                    <span class="font-display font-black text-2xl tracking-wider text-white flex items-center gap-1">
                        FIT IN 
                        <span class="text-gold relative inline-flex items-center">
                            7
                            <i class="fa-solid fa-biceps text-gold text-lg ml-0.5 transform -rotate-12 hover:scale-125 transition-transform" title="Fitness Bicep"></i>
                        </span>
                    </span>
                    <span class="block text-[9px] uppercase tracking-widest text-gold/80 font-semibold">Luxury Personal Coaching</span>
                </div>
            </div>

            <nav class="hidden md:flex items-center gap-8 text-xs uppercase font-bold tracking-widest text-gray-300">
                <a href="#about" class="hover:text-gold transition">About</a>
                <a href="#gallery" class="hover:text-gold transition">Motivation & Gym</a>
                <a href="#services" class="hover:text-gold transition">Programs</a>
                <a href="#consultation" class="hover:text-gold transition">₹99 Consultation</a>
            </nav>

            <div class="flex items-center gap-3">
                <button onclick="openBookingModal('1-on-1 Strategy Consultation Call', 99)" class="gold-btn px-5 py-2.5 rounded-full font-bold text-xs uppercase tracking-wider flex items-center gap-2">
                    <i class="fa-solid fa-phone"></i> ₹99 Consultation
                </button>
            </div>
        </div>
    </header>

    <!-- HERO SECTION -->
    <section class="pt-32 pb-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto relative overflow-hidden">
        <!-- Background Gym Visual Overlay -->
        <div class="absolute inset-0 z-0 opacity-15 bg-cover bg-center pointer-events-none rounded-3xl" style="background-image: url('https://images.unsplash.com/photo-1534438327276-14e5300c3a48?q=80&w=1400&auto=format&fit=crop');"></div>
        <div class="absolute -top-24 -right-24 w-96 h-96 bg-gold/10 rounded-full filter blur-3xl pointer-events-none"></div>
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center relative z-10">
            <div class="lg:col-span-7 space-y-6">
                <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-gold/15 border border-gold/40 text-gold text-xs font-semibold">
                    <i class="fa-solid fa-dumbbell text-xs"></i> Direct 1-on-1 Fitness & Body Transformation
                </div>

                <h1 class="font-display text-4xl sm:text-6xl font-black text-white leading-tight">
                    TRANSFORM YOUR BODY WITH 
                    <span class="gold-gradient-text block flex items-center gap-2">
                        FIT IN 7 <i class="fa-solid fa-biceps text-gold text-3xl sm:text-5xl inline-block"></i>
                    </span>
                </h1>

                <p class="text-gold font-bold text-base sm:text-lg tracking-wide uppercase font-display flex items-center gap-2">
                    <i class="fa-solid fa-fire-flame-curved text-amber-500"></i> 7 Days to Reset. 30 Days to Transform.
                </p>

                <p class="text-gray-300 text-sm sm:text-base leading-relaxed max-w-2xl">
                    No pre-recorded videos. Experience 1-on-1 live Zoom training, customized high-protein nutrition plans, posture & strength audits, or request <strong class="text-gold">Doorstep Personal Gym Training in Aligarh</strong>.
                </p>

                <div class="pt-4 flex flex-wrap items-center gap-4">
                    <a href="#services" class="gold-btn px-8 py-4 rounded-xl font-extrabold text-sm uppercase tracking-wider flex items-center gap-2">
                        View Training Plans <i class="fa-solid fa-arrow-right"></i>
                    </a>
                    <button onclick="openBookingModal('7-Day Online Live Trial', 1999)" class="bg-surface hover:bg-cardBg border border-gold/40 text-white px-8 py-4 rounded-xl font-bold text-sm uppercase tracking-wider transition flex items-center gap-2">
                        <i class="fa-solid fa-dumbbell text-gold"></i> Start 7-Day Trial (₹1,999)
                    </button>
                </div>

                <div class="grid grid-cols-3 gap-4 pt-6 border-t border-white/10 text-center sm:text-left">
                    <div>
                        <p class="text-xl font-black text-gold font-display flex items-center gap-1 justify-center sm:justify-start">
                            <i class="fa-solid fa-bolt text-xs"></i> 100% LIVE
                        </p>
                        <p class="text-[11px] text-gray-400 uppercase tracking-wider">Zoom & In-Person</p>
                    </div>
                    <div>
                        <p class="text-xl font-black text-gold font-display flex items-center gap-1 justify-center sm:justify-start">
                            <i class="fa-solid fa-location-dot text-xs"></i> ALIGARH
                        </p>
                        <p class="text-[11px] text-gray-400 uppercase tracking-wider">Doorstep Classes</p>
                    </div>
                    <div>
                        <p class="text-xl font-black text-gold font-display flex items-center gap-1 justify-center sm:justify-start">
                            <i class="fa-solid fa-apple-whole text-xs"></i> 1-ON-1
                        </p>
                        <p class="text-[11px] text-gray-400 uppercase tracking-wider">Personalized Diet</p>
                    </div>
                </div>
