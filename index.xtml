            <!-- Card 4: Personal Coaching -->
            <div class="group relative rounded-2xl overflow-hidden border border-white/10 bg-surface">
                <img src="https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?q=80&w=800&auto=format&fit=crop" alt="1 on 1 Doorstep Trainer" class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-500 opacity-80 group-hover:opacity-100">
                <div class="absolute inset-0 bg-gradient-to-t from-black via-black/30 to-transparent p-5 flex flex-col justify-end">
