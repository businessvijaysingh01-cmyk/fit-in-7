                <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Single Pass</span>
                <h3 class="font-display text-2xl font-bold text-white mt-2">1 Live Group Class</h3>
                <p class="text-xs text-gray-400 mt-1">Join energetic 60-minute group workouts on Zoom</p>

                <div class="my-6">
                    <span class="text-3xl font-black text-gold font-display">₹250</span>
                    <span class="text-xs text-gray-400"> / class</span>
                </div>

                <ul class="space-y-3 text-xs text-gray-300 mb-8">
                    <li class="flex items-center gap-2"><i class="fa-solid fa-check text-gold"></i> 60 Mins High Energy Zoom Session</li>
                    <li class="flex items-center gap-2"><i class="fa-solid fa-check text-gold"></i> Fat Loss & Body Weight Conditioning</li>
                </ul>

                <button onclick="openBookingModal('1 Live Group Zoom Class', 250)" class="w-full bg-surface border border-gold/40 text-white hover:bg-gold hover:text-black py-3.5 rounded-xl font-bold text-xs uppercase tracking-wider transition">
                    Book Class for ₹250
                </button>
            </div>

            <div class="bg-cardBg border border-gold/50 rounded-3xl p-6 sm:p-8">
                <span class="text-[10px] font-bold text-gold uppercase tracking-widest">Monthly Pass</span>
                <h3 class="font-display text-2xl font-bold text-white mt-2">Unlimited Group Pass</h3>
                <p class="text-xs text-gray-400 mt-1">Unlimited access to all daily group Zoom sessions</p>

                <div class="my-6">
                    <span class="text-3xl font-black text-gold font-display">₹2,999</span>
                    <span class="text-xs text-gray-400"> / month</span>
                </div>

                <ul class="space-y-3 text-xs text-gray-300 mb-8">
                    <li class="flex items-center gap-2"><i class="fa-solid fa-check text-gold"></i> Unlimited Daily Group Classes</li>
                    <li class="flex items-center gap-2"><i class="fa-solid fa-check text-gold"></i> Weekly Group Q&A & Diet Tips</li>
                </ul>

                <button onclick="openBookingModal('Unlimited Group Class Pass', 2999)" class="w-full gold-btn py-3.5 rounded-xl font-bold text-xs uppercase tracking-wider">
                    Get Monthly Pass (₹2,999)
                </button>
            </div>
        </div>
    </section>

    <!-- DIRECT CHECKOUT / BOOKING MODAL -->
    <div id="bookingModal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-black/85 backdrop-blur-md overflow-y-auto">
        <div class="relative w-full max-w-lg rounded-3xl bg-cardBg border border-gold/40 p-6 sm:p-8 shadow-2xl my-8">
            <button onclick="closeBookingModal()" class="absolute top-5 right-5 text-gray-400 hover:text-white text-xl">
                <i class="fa-solid fa-xmark"></i>
            </button>

            <div class="mb-4">
                <span class="text-[10px] font-bold uppercase tracking-widest text-gold bg-gold/10 px-3 py-1 rounded-full border border-gold/30">Direct Checkout</span>
                <h3 id="modalPackageTitle" class="font-display text-xl sm:text-2xl font-bold text-white mt-2">Book Your Session</h3>
                <p id="modalPackagePrice" class="text-2xl font-black text-gold mt-1">₹0</p>
            </div>

            <!-- Merchant Receiver Badge -->
            <div class="mb-5 bg-gold/10 border border-gold/30 rounded-2xl p-3 flex items-center gap-3">
                <div class="w-9 h-9 rounded-full bg-gold/20 flex items-center justify-center text-gold text-sm shrink-0">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <div class="text-xs">
                    <p class="text-gray-400 text-[10px] uppercase font-bold tracking-wider">Direct Verified Account</p>
                    <p class="text-white font-bold"><span id="merchantDisplay">FIT IN 7</span> (<span id="upiDisplay" class="text-gold">fitin7@upi</span>)</p>
                </div>
            </div>

            <form onsubmit="handleFormSubmit(event)" class="space-y-4 text-xs">
                <input type="hidden" id="selectedPackageInput">
                <input type="hidden" id="selectedPriceInput">

                <div>
                    <label class="block font-semibold text-gray-300 mb-1">Your Full Name</label>
                    <input type="text" id="clientName" required placeholder="e.g. Rahul Sharma" class="w-full bg-surface border border-white/10 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-gold">
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block font-semibold text-gray-300 mb-1">WhatsApp Phone Number</label>
                        <input type="tel" id="clientPhone" required placeholder="e.g. 9876543210" class="w-full bg-surface border border-white/10 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-gold">
                    </div>
                    <div>
                        <label class="block font-semibold text-gray-300 mb-1">Email Address</label>
                        <input type="email" id="clientEmail" required placeholder="name@gmail.com" class="w-full bg-surface border border-white/10 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-gold">
                    </div>
                </div>

                <div>
                    <label class="block font-semibold text-gray-300 mb-1">Preferred Slot / Address (if In-Person)</label>
                    <input type="text" id="preferredSlot" placeholder="e.g. Morning 8 AM or Address in Aligarh" class="w-full bg-surface border border-white/10 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-gold">
                </div>

                <!-- Payment Options -->
                <div>
                    <label class="block font-semibold text-gray-300 mb-2">Choose Payment Option</label>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                        <button type="button" onclick="selectPayMethod('gpay')" id="payBtn-gpay" class="pay-method-btn border-2 border-gold bg-gold/10 p-2.5 rounded-xl text-center flex flex-col items-center justify-center gap-1">
                            <i class="fa-brands fa-google-pay text-lg text-gold"></i>
                            <span class="text-[10px] font-bold text-white">Google Pay</span>
                        </button>
                        <button type="button" onclick="selectPayMethod('phonepe')" id="payBtn-phonepe" class="pay-method-btn border border-white/10 bg-surface p-2.5 rounded-xl text-center flex flex-col items-center justify-center gap-1">
                            <i class="fa-solid fa-mobile-screen-button text-lg text-gold"></i>
                            <span class="text-[10px] font-bold text-white">PhonePe</span>
                        </button>
                        <button type="button" onclick="selectPayMethod('qr')" id="payBtn-qr" class="pay-method-btn border border-white/10 bg-surface p-2.5 rounded-xl text-center flex flex-col items-center justify-center gap-1">
                            <i class="fa-solid fa-qrcode text-lg text-gold"></i>
                            <span class="text-[10px] font-bold text-white">Scan QR</span>
                        </button>
                        <button type="button" onclick="selectPayMethod('paytm')" id="payBtn-paytm" class="pay-method-btn border border-white/10 bg-surface p-2.5 rounded-xl text-center flex flex-col items-center justify-center gap-1">
                            <i class="fa-solid fa-wallet text-lg text-gold"></i>
                            <span class="text-[10px] font-bold text-white">Paytm UPI</span>
                        </button>
                    </div>
                </div>

                <!-- Dynamic QR Box -->
                <div id="qrCodeContainer" class="hidden text-center bg-surface border border-gold/30 p-4 rounded-2xl my-3">
                    <p class="text-[11px] text-gray-300 mb-2 font-medium">Scan with Google Pay, PhonePe, Paytm, or BHIM</p>
                    <div id="qrImageWrapper" class="flex justify-center my-2"></div>
                    <p class="text-[10px] text-gold font-mono">Receiver: <span class="currentDynamicUpi">fitin7@upi</span></p>
                </div>

                <button type="submit" class="w-full gold-btn py-3.5 rounded-xl font-bold uppercase tracking-wider text-xs flex items-center justify-center gap-2 mt-4 shadow-lg shadow-gold/20">
                    <i class="fa-solid fa-lock text-sm"></i> Proceed & Pay <span id="btnPayAmount">₹0</span>
                </button>
            </form>
        </div>
    </div>

    <!-- FOOTER -->
    <footer class="bg-surface border-t border-white/10 py-12 px-4 sm:px-6 lg:px-8">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-6 text-xs text-gray-400">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-gold/20 border border-gold flex items-center justify-center font-display font-bold text-gold">7</div>
                <span class="font-display font-bold text-lg text-white flex items-center gap-1">
                    FIT IN <span class="text-gold flex items-center">7 <i class="fa-solid fa-biceps text-gold text-sm ml-0.5"></i></span>
                </span>
            </div>
            <p>© 2026 FIT IN 7 by Bijendra Singh. All Rights Reserved. Serving Aligarh & Worldwide Online.</p>
            <div class="flex items-center gap-4 text-gold text-lg">
                <a href="https://wa.me/" target="_blank"><i class="fa-brands fa-whatsapp hover:text-white transition"></i></a>
                <a href="#"><i class="fa-brands fa-instagram hover:text-white transition"></i></a>
                <a href="#"><i class="fa-brands fa-youtube hover:text-white transition"></i></a>
            </div>
        </div>
    </footer>

    <!-- JAVASCRIPT CONTROLLER -->
    <script>
        let currentPayMethod = 'gpay';
        let currentPrice = 0;

        // DIRECT ACCOUNT DETAILS (Pre-filled for FIT IN 7)
        const merchantName = "FIT IN 7";
        const merchantUpiId = "fitin7@upi"; // Default UPI account VPA

        function switchTab(tab) {
            ['online', 'inperson', 'group'].forEach(t => {
                document.getElementById(`content-${t}`).classList.add('hidden');
                const btn = document.getElementById(`tab-${t}`);
                btn.classList.remove('bg-gold', 'text-black');
                btn.classList.add('text-gray-400');
            });

            document.getElementById(`content-${tab}`).classList.remove('hidden');
            const activeBtn = document.getElementById(`tab-${tab}`);
            activeBtn.classList.add('bg-gold', 'text-black');
            activeBtn.classList.remove('text-gray-400');
        }

        function openBookingModal(packageTitle, price) {
            currentPrice = price;
            document.getElementById('modalPackageTitle').innerText = packageTitle;
            document.getElementById('modalPackagePrice').innerText = '₹' + price.toLocaleString('en-IN');
            document.getElementById('btnPayAmount').innerText = '₹' + price.toLocaleString('en-IN');
            document.getElementById('selectedPackageInput').value = packageTitle;
            document.getElementById('selectedPriceInput').value = price;

            document.getElementById('merchantDisplay').innerText = merchantName;
            document.getElementById('upiDisplay').innerText = merchantUpiId;
            
            document.getElementById('bookingModal').classList.remove('hidden');
            selectPayMethod('gpay');
        }

        function closeBookingModal() {
            document.getElementById('bookingModal').classList.add('hidden');
        }

        function selectPayMethod(method) {
            currentPayMethod = method;
            const buttons = document.querySelectorAll('.pay-method-btn');
            buttons.forEach(btn => {
                btn.classList.remove('border-2', 'border-gold', 'bg-gold/10');
                btn.classList.add('border-white/10', 'bg-surface');
            });

            const activeBtn = document.getElementById(`payBtn-${method}`);
            if (activeBtn) {
                activeBtn.classList.remove('border-white/10', 'bg-surface');
                activeBtn.classList.add('border-2', 'border-gold', 'bg-gold/10');
            }

            const qrContainer = document.getElementById('qrCodeContainer');
            if (method === 'qr') {
                qrContainer.classList.remove('hidden');
                generateUpiQrCode(currentPrice);
            } else {
                qrContainer.classList.add('hidden');
            }
        }

        function generateUpiQrCode(amount) {
            const upiUrl = `upi://pay?pa=${encodeURIComponent(merchantUpiId)}&pn=${encodeURIComponent(merchantName)}&am=${amount}&cu=INR&tn=${encodeURIComponent('FIT IN 7 Session')}`;
            const qrWrapper = document.getElementById('qrImageWrapper');
            const qrImageUrl = `https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=${encodeURIComponent(upiUrl)}&color=d4af37&bgcolor=1a1a1a`;
            qrWrapper.innerHTML = `<img src="${qrImageUrl}" alt="Scan to pay ₹${amount}" class="rounded-xl border border-gold/40 shadow-lg">`;
            document.querySelectorAll('.currentDynamicUpi').forEach(el => el.textContent = merchantUpiId);
        }

        function handleFormSubmit(e) {
            e.preventDefault();

            const name = document.getElementById('clientName').value;
            const phone = document.getElementById('clientPhone').value;
            const email = document.getElementById('clientEmail').value;
            const pkg = document.getElementById('selectedPackageInput').value;
            const slot = document.getElementById('preferredSlot').value || 'Not specified';
            const amount = currentPrice;

            const upiIntentUrl = `upi://pay?pa=${encodeURIComponent(merchantUpiId)}&pn=${encodeURIComponent(merchantName)}&am=${amount}&cu=INR&tn=${encodeURIComponent('FIT IN 7 - ' + pkg)}`;

            // Launch UPI intent link for Mobile App Payments
            window.location.href = upiIntentUrl;

            // Trigger WhatsApp confirmation message to trainer
            setTimeout(() => {
                const message = `*NEW FIT IN 7 BOOKING*%0A%0A` +
                    `*Client:* ${encodeURIComponent(name)}%0A` +
                    `*Phone:* ${encodeURIComponent(phone)}%0A` +
                    `*Email:* ${encodeURIComponent(email)}%0A` +
                    `*Program:* ${encodeURIComponent(pkg)}%0A` +
                    `*Amount:* ₹${amount}%0A` +
                    `*Slot/Details:* ${encodeURIComponent(slot)}`;

                window.open(`https://wa.me/?text=${message}`, '_blank');
                closeBookingModal();
            }, 1200);
        }
    </script>
</body>
</html>
