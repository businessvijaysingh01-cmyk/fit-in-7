                    <div class="my-6 p-4 rounded-2xl bg-surface border border-white/5 flex items-center justify-between">
                        <div>
                            <p class="text-xs text-gray-400 line-through">Regular Fee: ₹999</p>
                            <p class="text-3xl font-black text-gold font-display">₹99 <span class="text-xs text-gray-400 font-sans font-normal">/ session</span></p>
                        </div>
                        <i class="fa-solid fa-comments text-3xl text-gold/30"></i>
                    </div>

                    <ul class="space-y-2.5 text-xs text-gray-300 mb-6">
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-gold"></i> Medical & Injury Background Review</li>
