            <!-- HERO CARD / OFFER -->
            <div id="consultation" class="lg:col-span-5">
                <div class="bg-cardBg/90 backdrop-blur-sm border border-gold/40 rounded-3xl p-6 sm:p-8 gold-border-glow relative">
                    <div class="absolute -top-3 right-6 bg-gold text-black font-extrabold text-[10px] uppercase tracking-widest px-3 py-1 rounded-full shadow">
                        Most Popular
                    </div>

                    <span class="text-xs font-bold text-gold uppercase tracking-widest flex items-center gap-1.5">
                        <i class="fa-solid fa-medal text-gold"></i> Special Entry Offer
                    </span>
                    <h2 class="font-display text-2xl font-bold text-white mt-1">1-on-1 Strategy Consultation</h2>
